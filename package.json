{
  "name": "devvit-app-template",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "dev": "devvit playtest"
  },
  "dependencies": {
    "@devvit/web": "0.15.6",
    "@hono/node-server": "^2.0.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@devvit/shared-types": "0.15.6",
    "@devvit/start": "0.15.6",
    "@devvit/test": "0.15.6",
    "@types/node": "^24.0.0",
    "devvit": "0.15.6",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.12"
  }
}
